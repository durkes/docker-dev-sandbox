*.tsbuildinfo

# Env / secrets -- nothing in this repo should ever hold a credential.
# The sandbox forwards ANTHROPIC_API_KEY from the host environment; it is never
# written to disk. Keep it that way.
.env
.env.*
!.env.example
*.pem
*.key

# Editor
.vscode/
.idea/
*.swp

# Claude Code local state (settings.local.json is machine-specific)
.claude/settings.local.json

# Local scratch
scratch/
tmp/
